#include <stdio.h>

int main() {
    int year, month, days;

    scanf("%d%d", &year, &month);

    if (year < 1900 || year > 9999 ||
        month < 1 || month > 12) {
        printf("0");
        return 0;
    }

    switch (month) {
        case 1:
        case 3:
        case 5:
        case 7:
        case 8:
        case 10:
        case 12:
            days = 31;
            break;

        case 4:
        case 6:
        case 9:
        case 11:
            days = 30;
            break;

        case 2:
            if ((year % 400 == 0) ||
                (year % 4 == 0 && year % 100 != 0)) {
                days = 29;
            } else {
                days = 28;
            }
            break;
    }

    printf("%d Days", days);

    return 0;
}

#include <stdio.h>

int main() {
    int units;
    float bill;

    scanf("%d", &units);

    if (units <= 200) {
        bill = units * 0.5;
    } else if (units <= 400) {
        bill = units * 0.65 + 100;
    } else if (units <= 600) {
        bill = units * 0.80 + 200;
    } else {
        bill = units * 1.25 + 425;
    }

    printf("Rs.%.0f", bill);

    return 0;
}
