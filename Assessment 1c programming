
#include <stdio.h>

int main() {
    float distance, fare = 100, discount;
    int member;

    scanf("%f", &distance);
    scanf("%d", &member);

    if (distance > 10) {
        fare += (distance - 10) * 20;
    }

    if (member == 1) {
        discount = fare * 0.10;
        fare -= discount;
    }

    printf("Final Fare: Rs.%.0f\n", fare);

    return 0;
}

