#include <stdio.h>

int main() {
    int treasure, x, y;
    int longBen, remaining, blackbeard, pirate;

    scanf("%d", &treasure);
    scanf("%d", &x);
    scanf("%d", &y);

    longBen = treasure * x / 100;
    remaining = treasure - longBen;

    blackbeard = remaining * y / 100;
    remaining -= blackbeard;

    pirate = remaining / 3;

    printf("%d\n", longBen);
    printf("%d\n", blackbeard);
    printf("%d\n", pirate);

    return 0;
}

#include <stdio.h>

int main() {
    int d1, c1, d2, c2;
    int totalCents, dollars, cents;

    scanf("%d%d%d%d", &d1, &c1, &d2, &c2);

    totalCents = (d1 + d2) * 100 + c1 + c2;

    dollars = totalCents / 100;
    cents = totalCents % 100;

    printf("%d\n%d\n", dollars, cents);

    return 0;
}

